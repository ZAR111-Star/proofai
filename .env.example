# Server
PORT=8080
PUBLIC_BASE_URL=https://your-domain.example.com
DATA_DIR=./data
COOKIE_SECURE=false
SESSION_DAYS=7

# Auth / Security
# 上线必须改成强随机字符串。可用 openssl rand -base64 32 生成。
PROOFAI_AUTH_PEPPER=change_this_auth_pepper
PROOFAI_DATA_ENCRYPTION_KEY=change_this_data_encryption_key
ADMIN_EMAIL=admin@proofai.local
ADMIN_PASSWORD=ProofAI@2026!

# WeChat Pay API v3
# 真实接入前必须在微信支付商户平台获取并配置以下信息。
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APPID=wx0000000000000000
WECHAT_PAY_MCHID=1900000001
WECHAT_PAY_MERCHANT_SERIAL_NO=0000000000000000000000000000000000000000
WECHAT_PAY_API_V3_KEY=32_byte_api_v3_key_here
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WECHAT_PAY_PLATFORM_CERT_PATH=./certs/wechatpay_platform.pem
WECHAT_PAY_NOTIFY_URL=https://your-domain.example.com/api/pay/wechat/notify

# Business
PROOFAI_ORDER_PREFIX=PAI
